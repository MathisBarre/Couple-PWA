# Base SQLite Turso (créées automatiquement par l'intégration Turso de Vercel).
# En local, laisser vide : un fichier local.db est utilisé.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signature des cookies de session : une longue chaîne aléatoire (openssl rand -hex 32)
AUTH_SECRET=

# Notifications push : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.com

# Protège la tâche planifiée /api/cron (Vercel l'envoie automatiquement)
CRON_SECRET=
