{
  "name": "cycle-a-deux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types scripts/test-cycles.ts && npm run test:spaces && npm run test:ucpa && npm run test:calendar && npm run test:lists",
    "test:spaces": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs --test scripts/test-spaces.ts",
    "test:ucpa": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs --test scripts/test-ucpa.ts",
    "icons": "pwa-assets-generator && pwa-assets-generator --config pwa-assets.full-bleed.config.ts",
    "test:calendar": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs --test scripts/test-calendar.ts",
    "test:lists": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs --test scripts/test-lists.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/functions": "^3.11.1",
    "amazon-cognito-identity-js": "^6.3.22",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "tough-cookie": "^6.1.0",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
