{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/join",
      "destination": "/api/join"
    },
    {
      "source": "/((?!api/|assets/|splash/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/logs.ts": {
      "maxDuration": 60
    },
    "api/groceries.ts": {
      "maxDuration": 60
    },
    "api/join.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/og-invite.ts": {
      "includeFiles": "api/_fonts/**"
    }
  }
}
